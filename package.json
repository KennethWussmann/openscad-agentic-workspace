{
  "name": "openscad-agentic-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@scad/web",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "e2e": "turbo run e2e",
    "scad": "node apps/cli/src/main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  }
}
